  "join_queries": {
    "Q01_copy_book_owner": {
      "sql": "SELECT c.copy_id,b.title,u.first_name||' '||u.last_name AS owner,c.condition,c.max_loan_days FROM bookbridge.book_copies c JOIN bookbridge.books b ON b.book_id=c.book_id JOIN bookbridge.users u ON u.user_id=c.owner_id ORDER BY c.copy_id",
      "rows": 24
    },
    "Q02_loan_copy_borrower": {
      "sql": "SELECT l.loan_id,c.copy_id,u.first_name||' '||u.last_name AS borrower,l.handover_mode,l.status,l.due_date FROM bookbridge.loans l JOIN bookbridge.book_copies c ON c.copy_id=l.copy_id JOIN bookbridge.users u ON u.user_id=l.borrower_id ORDER BY l.loan_id",
      "rows": 48
    },
    "Q03_payment_loan_confirmer": {
      "sql": "SELECT p.payment_id,l.loan_id,l.status AS loan_status,p.status AS payment_status,p.outbound_fee+p.return_fee AS total_eur,u.first_name||' '||u.last_name AS confirmed_by,p.confirmed_at FROM bookbridge.payments p JOIN bookbridge.loans l ON l.loan_id=p.loan_id LEFT JOIN bookbridge.users u ON u.user_id=p.confirmed_by_user_id ORDER BY p.payment_id",
      "rows": 24
    }
